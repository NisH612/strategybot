# Binance Futures Trading Bot API Key — required. Create at Binance > API Management.
BINANCE_API_KEY=
# Binance Futures Trading Bot API Secret — required.
BINANCE_SECRET=
# Use testnet (true) or live mainnet (false). Start with testnet.
BINANCE_TESTNET=true

# Trading pair (default: BTCUSDT).
SYMBOL=BTCUSDT

# Chart timeframe (default: 1h). Only 1h is tested.
TIMEFRAME=1h

# Virtual starting balance in USDT used for position sizing.
START_BALANCE=100

# Discord webhook/notifications
# Discord bot token. Create at https://discord.com/developers/applications
DISCORD_TOKEN=
# Discord channel ID for trade notifications.
DISCORD_CHANNEL_ID=

# --- Confidence Scoring ---
# Minimum confidence score (0-100) required to take a trade. Default: 70.
MIN_CONFIDENCE=70

# --- Risk Management ---
# Max daily loss in USDT before trading halts. 0 = unlimited.
MAX_DAILY_LOSS=0
# Max consecutive losing trades before trading halts. 0 = unlimited.
MAX_CONSECUTIVE_LOSSES=0
# Max bid-ask spread % before rejecting a trade. Default: 0.1
MAX_SPREAD=0.1
# Max volatility % (ATR-based) before rejecting a trade. Default: 5.0
MAX_VOLATILITY=5.0

# --- REST API Dashboard ---
# Bind address for the HTTP dashboard. Use 127.0.0.1 for local-only.
API_HOST=127.0.0.1
# Port for the HTTP dashboard.
API_PORT=8080

# --- Logging ---
# Number of compressed log archives to keep. Default: 30.
LOG_BACKUP_COUNT=30
# Minimum log level for console output (DEBUG, INFO, WARNING, ERROR). Default: INFO.
LOG_LEVEL=INFO
